# API Configuration - Environment Variables Template
# Copy this file to .env.local and fill in your API keys
# DO NOT commit this file to version control!

# ==========================================
# WEATHER API (OpenWeatherMap)
# ==========================================
# Get your free key at: https://openweathermap.org/api
# Type: Required for weather features
WEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY_HERE
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ==========================================
# MARKET API
# ==========================================
# Configure your market/commodity data provider
# Type: Optional (uses sample data if not configured)
MARKET_API_KEY=YOUR_MARKET_API_KEY_HERE
MARKET_API_BASE_URL=https://api.commoditymarket.com/v1

# ==========================================
# IMAGE PROCESSING API
# ==========================================
# For crop disease detection and analysis
# Type: Optional
IMAGE_API_KEY=YOUR_IMAGE_API_KEY_HERE
IMAGE_API_BASE_URL=https://api.imageprocessing.service/v1

# ==========================================
# LOCAL BACKEND SERVICES
# ==========================================
# These are local services running on your machine
# No API key needed

# Soil & Irrigation Sensor API
SOIL_API_BASE_URL=http://localhost:5000/api/v1

# Recommendation Engine API
RECOMMENDATION_API_BASE_URL=http://localhost:5000/api/v1

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# Language preference
APP_LANGUAGE=en

# Enable/disable dark mode
DARK_MODE_ENABLED=true

# Enable real-time updates
ENABLE_REAL_TIME=true

# API Timeout settings (in milliseconds)
WEATHER_TIMEOUT=10000
MARKET_TIMEOUT=15000
SOIL_TIMEOUT=10000
RECOMMENDATION_TIMEOUT=15000

# ==========================================
# SECURITY NOTE
# ==========================================
# NEVER commit actual API keys to version control!
# This file (.env.local) should be in .gitignore
# Use the template (.env.example) for reference

# How to use:
# 1. Copy this file: cp .env.example .env.local
# 2. Edit .env.local with your actual API keys
# 3. Load in your HTML: <script src="js/load-env.js"></script>
# Or use the API Key Manager in browser console:
#    apiKeyManager.setKey('weather', 'YOUR_KEY');
